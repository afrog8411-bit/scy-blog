---
const today = new Date();
import { SITE_SETTINGS } from "../lib/siteSettings";
---

<footer class="footer footer-center block mb-5 pt-10">
  <div class="pb-2">
    &copy; {today.getFullYear()} {SITE_SETTINGS.shared.brand}
  </div>
  <div class="inline opacity-75">
    <span data-localized data-localized-zh="联系邮箱：" data-localized-en="Email: ">联系邮箱：</span>
    <a href={`mailto:${SITE_SETTINGS.shared.contactEmail}`} class="font-bold">{SITE_SETTINGS.shared.contactEmail}</a>
  </div>
</footer>
