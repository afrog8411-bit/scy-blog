---
const today = new Date();
import LocalizedText from "./LocalizedText.astro";
import { localizeSection, SITE_SETTINGS } from "../lib/siteSettings";
const common = localizeSection("common");
---

<footer class="footer footer-center block mb-5 pt-10">
  <div class="pb-2">
    &copy; {today.getFullYear()} Manuel Ernesto
  </div>
  <div class="inline opacity-75">
    <LocalizedText value={common.developedBy} /> <a href="https://manuelernestog.github.io" target="_blank" class="font-bold">{SITE_SETTINGS.shared.brand}</a>
    <!-- Thanks for using this template. You can keep this line to support my work :) -->
    <a href="https://astrofy-template.netlify.app/" target="_blank" class="font-bold"><LocalizedText value={common.usingTemplate} /></a>
  </div>
</footer>
<style></style>
