---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { toLocalized, type LocalizedValue } from '../lib/localization';
import { SITE_SETTINGS } from '../lib/siteSettings';

export interface Props {
	title: LocalizedValue;
	description: LocalizedValue;
	image?: string;
	ogType?: string;
	publishedTime?: Date | string;
	modifiedTime?: Date | string;
	author?: string;
}

const {
	title,
	description,
	image = '/social_img.webp',
	ogType = 'website',
	publishedTime,
	modifiedTime,
	author = SITE_SETTINGS.shared.brand,
} = Astro.props;
const localizedTitle = toLocalized(title);
const localizedDescription = toLocalized(description);

function toIso(value: Date | string | undefined): string | undefined {
	if (!value) return undefined;
	const date = value instanceof Date ? value : new Date(value);
	return Number.isNaN(date.valueOf()) ? undefined : date.toISOString();
}

const canonicalUrl = Astro.url.toString();
const imageUrl = new URL(image, Astro.url).toString();
const publishedIso = toIso(publishedTime);
const modifiedIso = toIso(modifiedTime);
const structuredData = ogType === 'article'
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: localizedTitle.zh,
			description: localizedDescription.zh,
			url: canonicalUrl,
			image: imageUrl,
			author: { '@type': 'Person', name: author },
			...(publishedIso ? { datePublished: publishedIso } : {}),
			...(modifiedIso || publishedIso ? { dateModified: modifiedIso ?? publishedIso } : {}),
		}
	: {
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: localizedTitle.zh,
			description: localizedDescription.zh,
			url: canonicalUrl,
			image: imageUrl,
		};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={Astro.url} />
<link rel="alternate" type="application/rss+xml" title={`${SITE_SETTINGS.shared.brand} RSS`} href={new URL('/rss.xml', Astro.url)} />

<!-- Google Fonts: Newsreader (Editorial Serif) & JetBrains Mono (Geek Monospace) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Newsreader:opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700&display=swap"
  rel="stylesheet"
/>

<!-- Primary Meta Tags -->
<title data-localized data-localized-zh={localizedTitle.zh} data-localized-en={localizedTitle.en}>{localizedTitle.zh}</title>
<meta name="title" data-localized-meta data-localized-zh={localizedTitle.zh} data-localized-en={localizedTitle.en} content={localizedTitle.zh} />
<meta name="description" data-localized-meta data-localized-zh={localizedDescription.zh} data-localized-en={localizedDescription.en} content={localizedDescription.zh} />
<meta name="author" content={author} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={SITE_SETTINGS.shared.brand} />
<meta property="og:title" data-localized-meta data-localized-zh={localizedTitle.zh} data-localized-en={localizedTitle.en} content={localizedTitle.zh} />
<meta property="og:description" data-localized-meta data-localized-zh={localizedDescription.zh} data-localized-en={localizedDescription.en} content={localizedDescription.zh} />
<meta property="og:image" content={imageUrl} />
{ogType === 'article' && publishedIso && <meta property="article:published_time" content={publishedIso} />}
{ogType === 'article' && modifiedIso && <meta property="article:modified_time" content={modifiedIso} />}
{ogType === 'article' && <meta property="article:author" content={author} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" data-localized-meta data-localized-zh={localizedTitle.zh} data-localized-en={localizedTitle.en} content={localizedTitle.zh} />
<meta property="twitter:description" data-localized-meta data-localized-zh={localizedDescription.zh} data-localized-en={localizedDescription.en} content={localizedDescription.zh} />
<meta property="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

<script is:inline>
  try {
    const storedLocale = window.localStorage.getItem('site-language');
    if (storedLocale === 'en') {
      document.documentElement.dataset.language = 'en';
      document.documentElement.lang = 'en';
    }
    const storedTheme = window.localStorage.getItem('site-theme');
    if (storedTheme) {
      document.documentElement.setAttribute('data-theme', storedTheme);
    } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  } catch {
    // The default document remains usable when storage is unavailable.
  }
</script>
