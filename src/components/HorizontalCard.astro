---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import LocalizedText from "./LocalizedText.astro";
import { getLocalized, type LocalizedValue } from "../lib/localization";

const displayTitle = getLocalized(title as LocalizedValue);
const displayImage = img ? getLocalized(img as LocalizedValue) : undefined;
const displayBadge = badge ? getLocalized(badge as LocalizedValue) : "";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div
  class="group relative rounded-xl sm:rounded-2xl border border-base-content/10 bg-base-100/60 backdrop-blur-md hover:bg-base-100 hover:border-primary/40 transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 sm:hover:-translate-y-1 overflow-hidden my-2.5 sm:my-3 p-3.5 sm:p-5"
>
  <a href={url} target={target} class="absolute inset-0 z-0" aria-label={displayTitle}>
    <span class="sr-only">{displayTitle}</span>
  </a>

  <!-- Subtle card ambient hover glow -->
  <div class="absolute -right-20 -top-20 w-40 h-40 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/15 transition-all duration-500 pointer-events-none"></div>

  <div class="flex flex-col md:flex-row gap-3.5 sm:gap-5 items-start md:items-center relative pointer-events-none z-10">
    {
      displayImage && (
        <div class="relative shrink-0 w-full md:w-52 aspect-[16/9] md:aspect-auto md:h-32 rounded-lg sm:rounded-xl overflow-hidden bg-base-200 border border-base-content/5">
          <img
            src={displayImage}
            alt={displayTitle}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
    <div class="grow w-full">
      <div class="flex items-center flex-wrap gap-1.5 sm:gap-2">
        <h2 class="text-base sm:text-lg md:text-xl font-bold tracking-tight text-base-content group-hover:text-primary transition-colors leading-snug">
          <LocalizedText value={title as LocalizedValue} />
        </h2>
        {displayBadge && (
          <span class="badge badge-secondary badge-sm font-medium font-mono text-[10px] sm:text-[11px] px-1.5 py-0.5">
            <LocalizedText value={badge as LocalizedValue} />
          </span>
        )}
      </div>

      <p class="py-1.5 sm:py-2 text-xs sm:text-sm text-base-content/70 line-clamp-2 leading-relaxed font-normal">
        <LocalizedText value={desc as LocalizedValue} />
      </p>

      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1 sm:gap-1.5 mt-1 sm:mt-2 pointer-events-auto relative z-10">
          {tags.map((tag: string) => (
            <a
              href={`${tag_url}/${tag}`}
              class="badge badge-sm badge-ghost border border-base-content/15 font-mono text-[10px] sm:text-[11px] text-base-content/75 hover:border-primary hover:bg-primary/10 hover:text-primary transition-all duration-200 no-underline px-2 py-0.5"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</div>
