---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
import LocalizedText from "./LocalizedText.astro";
import { getLocalized, type LocalizedValue } from "../lib/localization";
const displayTitle = getLocalized(title as LocalizedValue);
const displayImage = img ? getLocalized(img as LocalizedValue) : undefined;
const displayBadge = badge ? getLocalized(badge as LocalizedValue) : "";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row">
      {
        displayImage && (
          <Image
            src={displayImage}
            width={750}
            height={422}
            format="webp"
            alt={displayTitle}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          <LocalizedText value={title as LocalizedValue} />
          {displayBadge && <div class="badge badge-secondary mx-2"><LocalizedText value={badge as LocalizedValue} /></div>}
        </h1>
        <p class="py-1 text-1xl"><LocalizedText value={desc as LocalizedValue} /></p>
        <div class="card-actions justify-end">
          {
            tags &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </a>
</div>
