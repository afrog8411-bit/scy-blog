---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
import LocalizedText from "./LocalizedText.astro";
import { getLocalized, type LocalizedValue } from "../lib/localization";

const displayTitle = getLocalized(title as LocalizedValue);
const displayImage = img ? getLocalized(img as LocalizedValue) : undefined;
const displayBadge = badge ? getLocalized(badge as LocalizedValue) : "";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div
  class="group relative rounded-2xl border border-base-content/10 bg-base-100/70 hover:bg-base-100 hover:border-base-content/25 transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 overflow-hidden my-3 p-4 sm:p-5"
>
  <a href={url} target={target} class="absolute inset-0 z-0" aria-label={displayTitle}>
    <span class="sr-only">{displayTitle}</span>
  </a>

  <div class="flex flex-col md:flex-row gap-5 items-start md:items-center relative pointer-events-none">
    {
      displayImage && (
        <div class="relative shrink-0 w-full md:w-52 h-44 md:h-32 rounded-xl overflow-hidden bg-base-200">
          <Image
            src={displayImage}
            width={750}
            height={422}
            format="webp"
            alt={displayTitle}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
      )
    }
    <div class="grow w-full">
      <div class="flex items-center flex-wrap gap-2">
        <h2 class="text-xl font-bold tracking-tight text-base-content group-hover:text-primary transition-colors">
          <LocalizedText value={title as LocalizedValue} />
        </h2>
        {displayBadge && (
          <span class="badge badge-secondary badge-sm font-medium">
            <LocalizedText value={badge as LocalizedValue} />
          </span>
        )}
      </div>

      <p class="py-2 text-sm sm:text-base text-base-content/70 line-clamp-2 leading-relaxed">
        <LocalizedText value={desc as LocalizedValue} />
      </p>

      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-2 pointer-events-auto relative z-10">
          {tags.map((tag: string) => (
            <a
              href={`${tag_url}/${tag}`}
              class="badge badge-sm badge-ghost border border-base-content/15 text-xs text-base-content/80 hover:border-primary hover:text-primary transition-colors no-underline"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</div>
