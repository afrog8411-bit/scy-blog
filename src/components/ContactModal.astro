---
import { SITE_SETTINGS } from "../lib/siteSettings";

const wechatId = SITE_SETTINGS.shared.wechat;
---

<dialog id="contact_modal" class="modal modal-bottom sm:modal-middle z-50">
  <div class="modal-box bg-base-100 border border-base-content/15 shadow-2xl rounded-2xl max-w-sm p-5 sm:p-6 text-base-content">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3 text-base-content/60 hover:text-base-content" aria-label="Close">✕</button>
    </form>

    <!-- Header -->
    <div class="flex items-center gap-2.5 pb-3 sm:pb-4 border-b border-base-content/10">
      <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></div>
      <h3 class="font-bold text-base sm:text-lg font-mono text-base-content flex items-center gap-2">
        <span data-localized data-localized-zh="联系方式" data-localized-en="Contact">联系方式</span>
        <span class="text-xs font-normal text-base-content/50 font-mono">/ WeChat</span>
      </h3>
    </div>

    <!-- WeChat Card -->
    <div class="mt-4">
      <div class="p-4 rounded-xl bg-base-200/60 border border-base-content/10 hover:border-emerald-500/40 transition-all duration-200 group">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2.5">
            <span class="text-emerald-500 flex items-center justify-center w-7 h-7 rounded-lg bg-emerald-500/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8.5 2C4.36 2 1 4.91 1 8.5c0 2.05 1.08 3.88 2.76 5.09L3 17l3.86-1.16c.52.1 1.07.16 1.64.16.27 0 .54-.02.8-.05-.2-.55-.3-1.14-.3-1.75 0-3.31 3.13-6 7-6 .42 0 .83.04 1.23.11C16.32 4.63 12.78 2 8.5 2zm-2.25 4c.69 0 1.25.56 1.25 1.25S6.94 8.5 6.25 8.5 5 7.94 5 7.25 5.56 6 6.25 6zm4.5 0c.69 0 1.25.56 1.25 1.25S11.44 8.5 10.75 8.5 9.5 7.94 9.5 7.25 10.06 6 10.75 6zM16 9.5c-3.31 0-6 2.24-6 5s2.69 5 6 5c.49 0 .96-.05 1.41-.14L20.5 21l-.69-2.73C21.14 17.21 22 15.7 22 14.5c0-2.76-2.69-5-6-5zm-2 3c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm4 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z"/>
              </svg>
            </span>
            <div>
              <div class="font-mono text-xs font-bold text-base-content/90" data-localized data-localized-zh="个人微信" data-localized-en="WeChat">个人微信</div>
              <div class="text-[10px] font-mono text-base-content/50" data-localized data-localized-zh="添加好友请注明来意" data-localized-en="Please add a note">添加好友请注明来意</div>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between gap-2 bg-base-100 px-3.5 py-2.5 rounded-lg border border-base-content/10 font-mono text-sm">
          <span class="font-bold text-emerald-600 dark:text-emerald-400 select-all tracking-wider text-sm sm:text-base">{wechatId}</span>
          <button
            type="button"
            class="copy-btn btn btn-xs btn-primary gap-1 font-mono text-xs shadow-none"
            data-copy-target={wechatId}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
            </svg>
            <span class="copy-btn-text" data-localized data-localized-zh="复制" data-localized-en="Copy">复制</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Footer Note -->
    <div class="mt-4 pt-3 border-t border-base-content/10 flex items-center justify-between text-[11px] font-mono text-base-content/50">
      <span data-localized data-localized-zh="欢迎交流沟通与探讨" data-localized-en="Feel free to connect">欢迎交流沟通与探讨</span>
      <form method="dialog">
        <button class="btn btn-ghost btn-xs text-base-content/70 hover:bg-base-200" data-localized data-localized-zh="关闭" data-localized-en="Close">关闭</button>
      </form>
    </div>
  </div>

  <form method="dialog" class="modal-backdrop bg-black/40 backdrop-blur-[2px]">
    <button>close</button>
  </form>
</dialog>

<script>
  function setupCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy-target]").forEach((btn) => {
      if (btn.dataset.copyBound === "true") return;
      btn.dataset.copyBound = "true";

      btn.addEventListener("click", async () => {
        const textToCopy = btn.dataset.copyTarget || "";
        const textSpan = btn.querySelector(".copy-btn-text");
        if (!textToCopy) return;

        let success = false;
        if (navigator.clipboard && window.isSecureContext) {
          try {
            await navigator.clipboard.writeText(textToCopy);
            success = true;
          } catch {}
        }
        if (!success) {
          const textArea = document.createElement("textarea");
          textArea.value = textToCopy;
          textArea.style.position = "fixed";
          textArea.style.opacity = "0";
          textArea.style.left = "-9999px";
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();
          try {
            success = document.execCommand("copy");
          } catch {}
          textArea.remove();
        }

        if (success && textSpan) {
          const originalText = textSpan.textContent;
          const isZh = document.documentElement.dataset.language !== "en";
          textSpan.textContent = isZh ? "✓ 已复制！" : "✓ Copied!";
          btn.classList.add("btn-success");
          setTimeout(() => {
            textSpan.textContent = originalText;
            btn.classList.remove("btn-success");
          }, 2000);
        }
      });
    });
  }

  setupCopyButtons();
  document.addEventListener("astro:page-load", setupCopyButtons);
</script>
