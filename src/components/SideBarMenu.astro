---
import LocalizedText from "./LocalizedText.astro";
import { localizeSection } from "../lib/siteSettings";

const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300"; // For primary color replace with `active` class
const navigation = localizeSection("navigation");
const projects = localizeSection("projects");
const services = localizeSection("services");
const cv = localizeSection("cv");
const hasProjects = Array.isArray(projects.items) && projects.items.length > 0;
const hasServices = Array.isArray(services.items) && services.items.length > 0;
const hasCv = [cv.education, cv.experience, cv.certifications].some(
  (items) => Array.isArray(items) && items.length > 0,
);
---

<ul class="menu grow shrink menu-md overflow-y-auto">
    <li><a class="py-3 text-base" id="home" href="/"><LocalizedText value={navigation.home} /></a></li>
    <li><a class="py-3 text-base" id="blog" href="/blog/"><LocalizedText value={navigation.blog} /></a></li>
    {hasProjects && <li><a class="py-3 text-base" id="projects" href="/projects/"><LocalizedText value={navigation.projects} /></a></li>}
    {hasServices && <li><a class="py-3 text-base" id="services" href="/services/"><LocalizedText value={navigation.services} /></a></li>}
    {hasCv && <li><a class="py-3 text-base" id="cv" href="/cv/"><LocalizedText value={navigation.cv} /></a></li>}
    <li><a class="py-3 text-base" id="shop" href="/store/"><LocalizedText value={navigation.store} /></a></li>
    <li>
        <button
            type="button"
            class="py-3 text-base flex items-center justify-between w-full text-left"
            id="contact-btn"
            onclick="const modal = document.getElementById('contact_modal'); if (modal) { modal.showModal(); } const drawer = document.getElementById('my-drawer'); if (drawer && window.innerWidth < 1024) drawer.checked = false;"
        >
            <span class="flex items-center gap-2">
                <LocalizedText value={navigation.contact} />
            </span>
            <span class="badge badge-sm badge-ghost font-mono text-[10px] text-emerald-500/90 border-emerald-500/20 bg-emerald-500/10">微信</span>
        </button>
    </li>
</ul>

<script define:vars={{ sideBarActiveItemID: sideBarActiveItemID, activeClass: activeClass }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
activeItemElem && activeItemElem.classList.add(activeClass);
</script>
