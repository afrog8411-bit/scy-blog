---
import SideBarFooter from "./SideBarFooter.astro";
import SideBarMenu from "./SideBarMenu.astro";
import { SITE_SETTINGS } from "../lib/siteSettings";
const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="px-3 pt-5 h-auto min-h-full w-[19rem] bg-base-200/80 backdrop-blur-md text-base-content flex flex-col border-r border-base-content/10">
    <div class="w-fit mx-auto mt-3 mb-5 flex flex-col items-center">
      <a href="/" class="group block relative">
        <div class="avatar transition-transform duration-300 ease-out group-hover:scale-105 block m-auto relative">
          <!-- Ambient Avatar Glow on hover -->
          <div class="absolute -inset-1 bg-gradient-to-r from-primary/30 to-secondary/30 rounded-full blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="w-[8.5rem] rounded-full ring-2 ring-base-content/10 ring-offset-4 ring-offset-base-200 group-hover:ring-primary/50 transition-all duration-300 overflow-hidden relative z-10 shadow-lg">
            <img
              class="mask mask-circle w-full h-full object-cover"
              width="300"
              height="300"
              src="/avatar.jpg"
              alt={SITE_SETTINGS.shared.brand}
              decoding="async"
            />
          </div>
        </div>
      </a>

      <!-- Geek Status Badge -->
      <div class="mt-4 flex items-center gap-1.5 px-3 py-1 rounded-full bg-base-100/80 border border-base-content/10 text-xs font-mono shadow-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-base-content/70 font-medium tracking-tight">Digital Explorer</span>
      </div>
    </div>

    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    <SideBarFooter />
  </aside>
</div>
