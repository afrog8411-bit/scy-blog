---
import SideBarFooter from "./SideBarFooter.astro";
import SideBarMenu from "./SideBarMenu.astro";
import { SITE_SETTINGS } from "../lib/siteSettings";
const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="px-3 pt-4 h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col border-r border-base-content/5">
    <div class="w-fit mx-auto mt-4 mb-6">
      <a href="/" class="group block">
        <div class="avatar transition-transform duration-300 ease-out group-hover:scale-105 block m-auto">
          <div class="w-[8.5rem] rounded-full ring-2 ring-base-content/10 ring-offset-4 ring-offset-base-200 group-hover:ring-primary/40 transition-all duration-300 overflow-hidden">
            <img
              class="mask mask-circle w-full h-full object-cover"
              width="300"
              height="300"
              src="/avatar.jpg"
              alt={SITE_SETTINGS.shared.brand}
              decoding="async"
            />
          </div>
        </div>
      </a>
    </div>
    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    <SideBarFooter />
  </aside>
</div>
