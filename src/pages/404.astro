---
import BaseLayout from "../layouts/BaseLayout.astro";
import LocalizedText from "../components/LocalizedText.astro";
import { localizeSection } from "../lib/siteSettings";

const notFound = localizeSection("notFound");
const common = localizeSection("common");
---

<BaseLayout title={notFound.title} includeSidebar={false}>
  <div class="text-center">
    <h1 class="text-9xl font-bold mb-4">🏝</h1>
    <h1 class="text-9xl font-bold mb-2">404</h1>
    <h3 class="text-2xl"><LocalizedText value={common.notFoundMessage} /></h3>
    <a class="btn btn-accent mt-9" href="/"><LocalizedText value={notFound.homeLabel} /></a>
  </div>
</BaseLayout>
