---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import LocalizedText from "../components/LocalizedText.astro";
import { getLocalized } from "../lib/localization";
import { localizeSection } from "../lib/siteSettings";

const services = localizeSection("services");
---

<BaseLayout title={services.title} sideBarActiveItemID="services">
  <div>
    <div class="text-3xl w-full font-bold mb-5"><LocalizedText value={services.heading} /></div>
  </div>

  {services.items.map((service, index) => (
    <>
      <HorizontalCard
        title={service.title}
        img={getLocalized(service.image)}
        desc={service.description}
        url={getLocalized(service.url)}
        target="_self"
        badge={service.badge}
      />
      {index < services.items.length - 1 && <div class="divider my-0" />}
    </>
  ))}
</BaseLayout>
