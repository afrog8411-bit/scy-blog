---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import LocalizedText from "../components/LocalizedText.astro";
import { getLocalized } from "../lib/localization";
import { localizeSection } from "../lib/siteSettings";

const projects = localizeSection("projects");
---

<BaseLayout title={projects.title} sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5"><LocalizedText value={projects.heading} /></div>
  </div>

  {projects.items.map((project, index) => (
    <>
      <HorizontalCard
        title={project.title}
        img={getLocalized(project.image)}
        desc={project.description}
        url={getLocalized(project.url)}
        target="_self"
        badge={project.badge}
      />
      {index < projects.items.length - 1 && <div class="divider my-0" />}
    </>
  ))}
</BaseLayout>
