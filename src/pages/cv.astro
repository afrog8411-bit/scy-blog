---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import LocalizedText from "../components/LocalizedText.astro";
import { localizeSection } from "../lib/siteSettings";

const cv = localizeSection("cv");
---

<BaseLayout title={cv.title} sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold"><LocalizedText value={cv.profileHeading} /></div>
  </div>

  <div class="mb-10 text-justify">
    <LocalizedText value={cv.profile} />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold"><LocalizedText value={cv.educationHeading} /></div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    {cv.education.map((item) => <TimeLineElement title={item.title} subtitle={item.subtitle} />)}
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold"><LocalizedText value={cv.experienceHeading} /></div>
  </div>

  <div class="time-line-container mb-10">
    {cv.experience.map((item) => (
      <TimeLineElement title={item.title} subtitle={item.subtitle}>
        <LocalizedText value={item.description} />
      </TimeLineElement>
    ))}
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold"><LocalizedText value={cv.certificationsHeading} /></div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    {cv.certifications.map((certification) => (
      <li><a href={certification.url.zh} target="_blank"><LocalizedText value={certification.name} /></a></li>
    ))}
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold"><LocalizedText value={cv.skillsHeading} /></div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    {cv.skills.map((skill) => <li><LocalizedText value={skill} /></li>)}
  </ul>
</BaseLayout>
