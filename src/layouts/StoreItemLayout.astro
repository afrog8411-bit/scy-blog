---
import { type StoreSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import LocalizedText from "../components/LocalizedText.astro";
import { localizeSection } from "../lib/siteSettings";

export interface Props extends StoreSchema {}

const {
  title,
  description,
  updatedDate,
  heroImage,
  pricing,
  oldPricing,
  checkoutUrl,
  badge,
  custom_link,
  custom_link_label,
} = Astro.props;
const common = localizeSection("common");

dayjs.extend(localizedFormat);
const displayDate = dayjs(updatedDate).format("YYYY-MM-DD");
---

<BaseLayout title={title} description={description} image={heroImage}>
  <main class="md:flex md:justify-center">
    <article class="prose prose-base sm:prose-lg dark:prose-invert max-w-[780px] w-full break-words">
      <!-- Back to store navigation -->
      <div class="not-prose mb-4 sm:mb-6">
        <a
          href="/store"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-mono text-base-content/60 hover:text-primary transition-colors group px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg hover:bg-base-200/60 w-fit"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span data-localized data-localized-zh="cd ~/store" data-localized-en="cd ~/store">cd ~/store</span>
        </a>
      </div>

      <!-- Hero Image -->
      {
        heroImage && (
          <div class="not-prose mb-5 sm:mb-8 rounded-xl sm:rounded-2xl overflow-hidden border border-base-content/10 shadow-md sm:shadow-lg relative aspect-[16/9] sm:aspect-[21/9] max-h-[380px] bg-base-200">
            <img
              src={heroImage}
              alt={title}
              class="w-full h-full object-cover transition-transform duration-500 hover:scale-[1.02]"
              loading="eager"
              decoding="async"
            />
          </div>
        )
      }

      <!-- Item Header -->
      <div class="not-prose pb-4 sm:pb-5 border-b border-base-content/10">
        <div class="flex items-center flex-wrap gap-2 mb-2">
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-base-content leading-tight">
            {title}
          </h1>
          {badge && <span class="badge badge-secondary font-mono text-xs">{badge}</span>}
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 mt-3 pt-2">
          <div class="flex items-baseline gap-2.5">
            <span class="text-2xl sm:text-3xl font-black text-primary font-mono">{pricing}</span>
            {oldPricing && <span class="text-sm text-base-content/40 line-through font-mono">{oldPricing}</span>}
          </div>
          <div class="flex items-center gap-2">
            <button
              type="button"
              class="btn btn-primary btn-sm sm:btn-md gap-1.5 font-mono shadow-sm"
              onclick="document.getElementById('contact_modal')?.showModal()"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8.5 2C4.36 2 1 4.91 1 8.5c0 2.05 1.08 3.88 2.76 5.09L3 17l3.86-1.16c.52.1 1.07.16 1.64.16.27 0 .54-.02.8-.05-.2-.55-.3-1.14-.3-1.75 0-3.31 3.13-6 7-6 .42 0 .83.04 1.23.11C16.32 4.63 12.78 2 8.5 2zm-2.25 4c.69 0 1.25.56 1.25 1.25S6.94 8.5 6.25 8.5 5 7.94 5 7.25 5.56 6 6.25 6zm4.5 0c.69 0 1.25.56 1.25 1.25S11.44 8.5 10.75 8.5 9.5 7.94 9.5 7.25 10.06 6 10.75 6zM16 9.5c-3.31 0-6 2.24-6 5s2.69 5 6 5c.49 0 .96-.05 1.41-.14L20.5 21l-.69-2.73C21.14 17.21 22 15.7 22 14.5c0-2.76-2.69-5-6-5zm-2 3c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm4 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z"/>
              </svg>
              <span data-localized data-localized-zh="微信咨询开通" data-localized-en="Contact via WeChat">微信咨询开通</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Article / Product Description Body -->
      <div class="article-body mt-6">
        <slot />
      </div>

      <!-- Author / Contact Card -->
      <div class="not-prose my-8 sm:my-10 p-4 sm:p-5 rounded-xl sm:rounded-2xl border border-base-content/15 bg-base-200/50 backdrop-blur-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="avatar">
            <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full ring-2 ring-primary/30 overflow-hidden">
              <img src="/avatar.jpg" alt="a frog" class="w-full h-full object-cover" />
            </div>
          </div>
          <div>
            <div class="font-bold text-sm sm:text-base text-base-content flex items-center gap-2 font-mono">
              <span>a frog</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 font-medium flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span data-localized data-localized-zh="微信在线" data-localized-en="WeChat Online">微信在线</span>
              </span>
            </div>
            <div class="text-xs text-base-content/60 font-mono mt-1" data-localized data-localized-zh="官方正规代充，有任何疑问欢迎随时咨询" data-localized-en="Feel free to connect and ask any questions">
              官方正规代充，有任何疑问欢迎随时咨询
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            class="copy-btn btn btn-sm btn-outline gap-1.5 font-mono text-xs hover:border-emerald-500 hover:bg-emerald-500 hover:text-white"
            data-copy-target="kingandlonger"
            title="点击复制微信号"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8.5 2C4.36 2 1 4.91 1 8.5c0 2.05 1.08 3.88 2.76 5.09L3 17l3.86-1.16c.52.1 1.07.16 1.64.16.27 0 .54-.02.8-.05-.2-.55-.3-1.14-.3-1.75 0-3.31 3.13-6 7-6 .42 0 .83.04 1.23.11C16.32 4.63 12.78 2 8.5 2zm-2.25 4c.69 0 1.25.56 1.25 1.25S6.94 8.5 6.25 8.5 5 7.94 5 7.25 5.56 6 6.25 6zm4.5 0c.69 0 1.25.56 1.25 1.25S11.44 8.5 10.75 8.5 9.5 7.94 9.5 7.25 10.06 6 10.75 6zM16 9.5c-3.31 0-6 2.24-6 5s2.69 5 6 5c.49 0 .96-.05 1.41-.14L20.5 21l-.69-2.73C21.14 17.21 22 15.7 22 14.5c0-2.76-2.69-5-6-5zm-2 3c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm4 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z"/>
            </svg>
            <span class="copy-btn-text" data-localized data-localized-zh="微信：kingandlonger" data-localized-en="WeChat: kingandlonger">微信：kingandlonger</span>
          </button>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>

<script>
  import "../scripts/obsidianMarkdown";
</script>
