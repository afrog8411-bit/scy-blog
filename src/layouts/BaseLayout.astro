---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import SideBar from "../components/SideBar.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import { ViewTransitions } from "astro:transitions";

import { SITE_SETTINGS } from "../lib/siteSettings";
import { TRANSITION_API } from "../config";
import type { LocalizedValue } from "../lib/localization";

interface Props {
  image?: string;
  title?: LocalizedValue;
  description?: LocalizedValue;
  includeSidebar?: boolean;
  sideBarActiveItemID?: string;
  ogType?: string;
}

const {
  image,
  title = { zh: SITE_SETTINGS.zh.siteTitle, en: SITE_SETTINGS.en.siteTitle },
  description = { zh: SITE_SETTINGS.zh.siteDescription, en: SITE_SETTINGS.en.siteDescription },
  includeSidebar = true,
  sideBarActiveItemID,
  ogType,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-language="zh" data-theme="lofi">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body class="relative min-h-screen bg-base-100 selection:bg-primary/20 selection:text-primary overflow-x-hidden antialiased">
    <!-- Subtle Geek Dot-Grid Background & Ambient Glow -->
    <div class="fixed inset-0 pointer-events-none z-0 geek-grid-pattern opacity-60"></div>
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[650px] h-[280px] bg-gradient-to-tr from-primary/10 via-primary/5 to-transparent blur-[120px] rounded-full pointer-events-none -z-10"></div>

    <LanguageSwitch />
    <div class="bg-transparent drawer lg:drawer-open relative z-10">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content bg-transparent min-h-screen flex flex-col">
        <Header title={SITE_SETTINGS.shared.brand} />
        <div class="md:flex md:justify-center grow">
          <main class="p-5 sm:p-8 pt-8 lg:pt-10 lg:max-w-[920px] max-w-[100vw] w-full">
            <slot />
          </main>
        </div>
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
    </div>
  </body>
</html>
