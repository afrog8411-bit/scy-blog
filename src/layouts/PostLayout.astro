---
import { type BlogSchema } from "../content/config";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import LocalizedText from "../components/LocalizedText.astro";
import { localizeSection } from "../lib/siteSettings";
import { calculateReadingTime } from "../lib/readingTime";
import createSlug from "../lib/createSlug";
import { Image } from "astro:assets";

export interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props extends BlogSchema {
  rawContent?: string;
  headings?: MarkdownHeading[];
  prevPost?: CollectionEntry<"blog"> | null;
  nextPost?: CollectionEntry<"blog"> | null;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  badge,
  tags = [],
  rawContent = "",
  headings = [],
  prevPost,
  nextPost,
} = Astro.props;

const common = localizeSection("common");
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll");
const readingStats = calculateReadingTime(rawContent);
const tocHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
---

<BaseLayout title={title} description={description} image={heroImage} ogType="article">
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-primary z-50 transition-[width] duration-75 ease-out w-0 pointer-events-none"></div>

  <main class="md:flex md:justify-center">
    <article class="prose prose-lg dark:prose-invert max-w-[750px] w-full">
      <!-- Back to blog navigation -->
      <div class="not-prose mb-6">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-base-content/60 hover:text-primary transition-colors group"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 transition-transform group-hover:-translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span data-localized data-localized-zh="返回博客列表" data-localized-en="Back to blog">返回博客列表</span>
        </a>
      </div>

      <!-- Hero Image -->
      {
        heroImage && (
          <div class="not-prose mb-8 rounded-2xl overflow-hidden border border-base-content/10 shadow-md">
            <Image width={750} height={422} format="webp" src={heroImage} alt={title} class="w-full h-auto object-cover" />
          </div>
        )
      }

      <!-- Article Header -->
      <header class="not-prose mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-base-content my-3 leading-tight">
          {title}
        </h1>

        <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-xs sm:text-sm text-base-content/60 mt-3">
          {
            pubDate && (
              <div class="flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <time>{displayDate}</time>
              </div>
            )
          }

          <div class="flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span
              data-localized
              data-localized-zh={`约 ${readingStats.minutes} 分钟阅读 · ${readingStats.words} 字`}
              data-localized-en={`${readingStats.minutes} min read · ${readingStats.words} words`}
            >
              约 {readingStats.minutes} 分钟阅读 · {readingStats.words} 字
            </span>
          </div>

          {badge && <span class="badge badge-secondary badge-sm font-medium">{badge}</span>}
        </div>

        {
          updatedDate && (
            <div class="text-xs text-base-content/50 mt-2">
              <LocalizedText value={common.lastUpdated} /> <time>{updatedDate}</time>
            </div>
          )
        }

        {
          tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-4">
              {tags.map((tag) => (
                <a
                  href={`/blog/tag/${tag}`}
                  class="badge badge-sm badge-ghost border border-base-content/15 text-xs text-base-content/80 hover:border-primary hover:text-primary transition-colors no-underline"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </header>

      <!-- Table of Contents (TOC) -->
      {
        tocHeadings.length > 1 && (
          <details class="not-prose my-6 rounded-2xl border border-base-content/10 bg-base-100/70 p-4 open:bg-base-100 transition-colors shadow-sm">
            <summary class="font-bold text-sm flex items-center justify-between cursor-pointer select-none text-base-content hover:text-primary transition-colors">
              <span class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
                <span data-localized data-localized-zh="文章目录" data-localized-en="Table of Contents">文章目录</span>
              </span>
              <span class="text-xs font-normal opacity-50" data-localized data-localized-zh="点击展开/收起" data-localized-en="Toggle">点击展开/收起</span>
            </summary>
            <nav class="mt-3 pt-3 border-t border-base-content/10 flex flex-col gap-1 text-sm">
              {tocHeadings.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  data-toc-link
                  class={`py-1 text-base-content/75 hover:text-primary transition-colors block ${
                    heading.depth === 1 ? "font-semibold" : heading.depth === 2 ? "pl-3 text-xs sm:text-sm" : "pl-6 text-xs text-base-content/60"
                  }`}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </details>
        )
      }

      <div class="divider my-4 not-prose border-base-content/10"></div>

      <!-- Main Body -->
      <div class="article-body">
        <slot />
      </div>

      <!-- Post Actions (Share / Back to Top) -->
      <div class="not-prose mt-10 pt-6 border-t border-base-content/10 flex flex-wrap items-center justify-between gap-3">
        <button
          type="button"
          id="copy-post-link"
          class="btn btn-ghost btn-sm gap-2 text-base-content/70 hover:text-primary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          <span id="copy-link-text" data-localized data-localized-zh="分享 / 复制链接" data-localized-en="Share / Copy Link">分享 / 复制链接</span>
        </button>

        <button
          type="button"
          id="back-to-top"
          class="btn btn-ghost btn-sm gap-2 text-base-content/70 hover:text-primary"
        >
          <span data-localized data-localized-zh="回到顶部" data-localized-en="Back to top">回到顶部</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </button>
      </div>

      <!-- Previous & Next Posts Navigation Cards -->
      {
        (prevPost || nextPost) && (
          <nav class="not-prose mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
            {prevPost ? (
              <a
                href={"/blog/" + createSlug(prevPost.data.title, prevPost.slug)}
                class="group rounded-xl border border-base-content/10 bg-base-100/60 hover:bg-base-100 hover:border-base-content/25 p-4 transition-all duration-300 hover:shadow-sm flex flex-col justify-between"
              >
                <div class="text-xs text-base-content/50 mb-1 flex items-center gap-1">
                  <span>&larr;</span>
                  <span data-localized data-localized-zh="较早的文章" data-localized-en="Previous Post">较早的文章</span>
                </div>
                <div class="font-bold text-sm sm:text-base text-base-content group-hover:text-primary transition-colors line-clamp-2">
                  {prevPost.data.title}
                </div>
              </a>
            ) : (
              <div class="hidden sm:block" />
            )}

            {nextPost ? (
              <a
                href={"/blog/" + createSlug(nextPost.data.title, nextPost.slug)}
                class="group rounded-xl border border-base-content/10 bg-base-100/60 hover:bg-base-100 hover:border-base-content/25 p-4 transition-all duration-300 hover:shadow-sm flex flex-col justify-between text-right"
              >
                <div class="text-xs text-base-content/50 mb-1 flex items-center justify-end gap-1">
                  <span data-localized data-localized-zh="较新的文章" data-localized-en="Next Post">较新的文章</span>
                  <span>&rarr;</span>
                </div>
                <div class="font-bold text-sm sm:text-base text-base-content group-hover:text-primary transition-colors line-clamp-2">
                  {nextPost.data.title}
                </div>
              </a>
            ) : (
              <div class="hidden sm:block" />
            )}
          </nav>
        )
      }
    </article>
  </main>
</BaseLayout>

<script>
  import "../scripts/obsidianMarkdown";

  function setupPostInteractions() {
    // 1. Reading Progress Bar
    const progressBar = document.getElementById("reading-progress");
    if (progressBar) {
      const updateProgress = () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
        progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
      };
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();
    }

    // 2. Back to Top Button
    const backToTopBtn = document.getElementById("back-to-top");
    if (backToTopBtn) {
      backToTopBtn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    // 3. Share / Copy Post Link Button
    const copyLinkBtn = document.getElementById("copy-post-link");
    const copyLinkText = document.getElementById("copy-link-text");
    if (copyLinkBtn && copyLinkText) {
      copyLinkBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const originalText = copyLinkText.textContent;
          copyLinkText.textContent = "✓ 已复制链接！";
          copyLinkText.classList.add("text-success");
          setTimeout(() => {
            copyLinkText.textContent = originalText;
            copyLinkText.classList.remove("text-success");
          }, 2000);
        } catch {}
      });
    }
  }

  setupPostInteractions();
  document.addEventListener("astro:page-load", setupPostInteractions);
</script>
