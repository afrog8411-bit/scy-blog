---
import { type BlogSchema } from "../content/config";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import LocalizedText from "../components/LocalizedText.astro";
import { localizeSection } from "../lib/siteSettings";
import { calculateReadingTime } from "../lib/readingTime";
import createSlug from "../lib/createSlug";

export interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props extends BlogSchema {
  rawContent?: string;
  headings?: MarkdownHeading[];
  prevPost?: CollectionEntry<"blog"> | null;
  nextPost?: CollectionEntry<"blog"> | null;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  badge,
  tags = [],
  rawContent = "",
  headings = [],
  prevPost,
  nextPost,
} = Astro.props;

const common = localizeSection("common");
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("YYYY-MM-DD");
const readingStats = calculateReadingTime(rawContent);
const tocHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
---

<BaseLayout title={title} description={description} image={heroImage} ogType="article">
  <!-- Glowing Geek Reading Progress Bar -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 h-[3px] bg-gradient-to-r from-primary via-indigo-500 to-accent shadow-[0_0_10px_rgba(99,102,241,0.7)] z-50 transition-[width] duration-75 ease-out w-0 pointer-events-none"
  ></div>

  <main class="md:flex md:justify-center">
    <!-- Responsive Typography: prose-base on mobile, prose-lg on tablets and desktops -->
    <article class="prose prose-base sm:prose-lg dark:prose-invert max-w-[780px] w-full break-words">
      <!-- Back to blog navigation -->
      <div class="not-prose mb-4 sm:mb-6">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-mono text-base-content/60 hover:text-primary transition-colors group px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg hover:bg-base-200/60 w-fit"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span data-localized data-localized-zh="cd ~/blog" data-localized-en="cd ~/blog">cd ~/blog</span>
        </a>
      </div>

      <!-- Hero Image: Responsive Aspect Ratio Container with Zero Distortion -->
      {
        heroImage && (
          <div class="not-prose mb-5 sm:mb-8 rounded-xl sm:rounded-2xl overflow-hidden border border-base-content/10 shadow-md sm:shadow-lg relative group aspect-[16/9] sm:aspect-[21/9] max-h-[360px] bg-base-200">
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-10"></div>
            <img
              src={heroImage}
              alt={title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              loading="eager"
              decoding="async"
            />
          </div>
        )
      }

      <!-- Article Header -->
      <header class="not-prose mb-4 sm:mb-6">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-base-content my-2 sm:my-3 leading-snug sm:leading-tight">
          {title}
        </h1>

        <!-- Geek Meta Info Pills -->
        <div class="flex flex-wrap items-center gap-y-1.5 gap-x-2 text-[11px] sm:text-xs font-mono text-base-content/65 mt-3 sm:mt-4">
          {
            pubDate && (
              <div class="flex items-center gap-1.5 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-md bg-base-200/70 border border-base-content/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-3.5 sm:h-3.5 opacity-70 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <time>{displayDate}</time>
              </div>
            )
          }

          <div class="flex items-center gap-1.5 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-md bg-base-200/70 border border-base-content/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 sm:w-3.5 sm:h-3.5 opacity-70 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span
              data-localized
              data-localized-zh={`${readingStats.minutes} 分钟 · ${readingStats.words} 字`}
              data-localized-en={`${readingStats.minutes} min · ${readingStats.words} words`}
            >
              {readingStats.minutes} 分钟 · {readingStats.words} 字
            </span>
          </div>

          <!-- Obsidian Enhanced Badge -->
          <div class="flex items-center gap-1 px-2 py-0.5 sm:py-1 rounded-md bg-purple-500/10 border border-purple-500/20 text-purple-400 text-[10px] sm:text-[11px] font-semibold">
            <span>✦</span>
            <span>Obsidian</span>
          </div>

          {badge && <span class="badge badge-secondary badge-sm font-medium font-mono text-[10px] sm:text-xs">{badge}</span>}
        </div>

        {
          updatedDate && (
            <div class="text-[10px] sm:text-[11px] font-mono text-base-content/50 mt-2">
              <LocalizedText value={common.lastUpdated} /> <time>{updatedDate}</time>
            </div>
          )
        }

        {
          tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-3 sm:mt-4">
              {tags.map((tag) => (
                <a
                  href={`/blog/tag/${tag}`}
                  class="badge badge-sm badge-ghost border border-base-content/15 font-mono text-[11px] sm:text-xs text-base-content/80 hover:border-primary hover:text-primary hover:bg-primary/10 transition-all no-underline"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </header>

      <!-- Table of Contents (TOC) -->
      {
        tocHeadings.length > 1 && (
          <details class="not-prose my-4 sm:my-6 rounded-xl sm:rounded-2xl border border-base-content/15 bg-base-200/50 backdrop-blur-md p-3 sm:p-4 open:bg-base-200/80 transition-all shadow-sm group/toc">
            <summary class="font-bold text-xs sm:text-sm flex items-center justify-between cursor-pointer select-none text-base-content hover:text-primary transition-colors">
              <span class="flex items-center gap-1.5 sm:gap-2 font-mono">
                <span class="text-primary font-bold">#</span>
                <span data-localized data-localized-zh="文章大纲 (TOC)" data-localized-en="Table of Contents">文章大纲 (TOC)</span>
              </span>
              <span class="text-[11px] sm:text-xs font-mono font-normal opacity-50 flex items-center gap-1">
                <span data-localized data-localized-zh="展开/收起" data-localized-en="Toggle">展开/收起</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-open/toc:rotate-180"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </span>
            </summary>
            <nav class="mt-2.5 pt-2.5 sm:mt-3 sm:pt-3 border-t border-base-content/10 flex flex-col gap-0.5 sm:gap-1 text-xs sm:text-sm font-mono">
              {tocHeadings.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  data-toc-link
                  class={`py-1 text-base-content/70 hover:text-primary hover:bg-base-100/50 rounded px-1.5 sm:px-2 transition-colors block ${
                    heading.depth === 1 ? "font-semibold text-base-content/90" : heading.depth === 2 ? "pl-3 sm:pl-4 text-[11px] sm:text-xs md:text-sm" : "pl-6 sm:pl-7 text-[10px] sm:text-xs text-base-content/55"
                  }`}
                >
                  <span class="opacity-40 mr-1">{heading.depth === 1 ? "§" : heading.depth === 2 ? "└─" : "  └─"}</span>
                  {heading.text}
                </a>
              ))}
            </nav>
          </details>
        )
      }

      <div class="divider my-4 sm:my-6 not-prose border-base-content/10"></div>

      <!-- Main Body -->
      <div class="article-body">
        <slot />
      </div>

      <!-- Post Actions (Share / Back to Top) -->
      <div class="not-prose mt-8 sm:mt-12 pt-5 sm:pt-6 border-t border-base-content/15 flex flex-wrap items-center justify-between gap-2.5 font-mono text-[11px] sm:text-xs">
        <button
          type="button"
          id="copy-post-link"
          class="btn btn-ghost btn-sm gap-1.5 text-base-content/70 hover:text-primary hover:bg-base-200/80 px-2.5"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          <span id="copy-link-text" data-localized data-localized-zh="分享 / 复制链接" data-localized-en="Share / Copy Link">分享 / 复制链接</span>
        </button>

        <button
          type="button"
          id="back-to-top"
          class="btn btn-ghost btn-sm gap-1.5 text-base-content/70 hover:text-primary hover:bg-base-200/80 px-2.5"
        >
          <span data-localized data-localized-zh="回到顶部" data-localized-en="Back to top">回到顶部</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </button>
      </div>

      <!-- Previous & Next Posts Navigation Cards -->
      {
        (prevPost || nextPost) && (
          <nav class="not-prose mt-6 sm:mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 font-mono">
            {prevPost ? (
              <a
                href={"/blog/" + createSlug(prevPost.data.title, prevPost.slug)}
                class="group rounded-xl sm:rounded-2xl border border-base-content/10 bg-base-100/60 backdrop-blur-sm hover:bg-base-100 hover:border-primary/40 p-3.5 sm:p-4 transition-all duration-300 hover:shadow-md flex flex-col justify-between"
              >
                <div class="text-[10px] sm:text-xs text-base-content/50 mb-1 flex items-center gap-1 font-mono">
                  <span>&larr;</span>
                  <span data-localized data-localized-zh="PREV_POST" data-localized-en="PREV_POST">PREV_POST</span>
                </div>
                <div class="font-sans font-bold text-xs sm:text-sm md:text-base text-base-content group-hover:text-primary transition-colors line-clamp-2">
                  {prevPost.data.title}
                </div>
              </a>
            ) : (
              <div class="hidden sm:block" />
            )}

            {nextPost ? (
              <a
                href={"/blog/" + createSlug(nextPost.data.title, nextPost.slug)}
                class="group rounded-xl sm:rounded-2xl border border-base-content/10 bg-base-100/60 backdrop-blur-sm hover:bg-base-100 hover:border-primary/40 p-3.5 sm:p-4 transition-all duration-300 hover:shadow-md flex flex-col justify-between text-right"
              >
                <div class="text-[10px] sm:text-xs text-base-content/50 mb-1 flex items-center justify-end gap-1 font-mono">
                  <span data-localized data-localized-zh="NEXT_POST" data-localized-en="NEXT_POST">NEXT_POST</span>
                  <span>&rarr;</span>
                </div>
                <div class="font-sans font-bold text-xs sm:text-sm md:text-base text-base-content group-hover:text-primary transition-colors line-clamp-2">
                  {nextPost.data.title}
                </div>
              </a>
            ) : (
              <div class="hidden sm:block" />
            )}
          </nav>
        )
      }
    </article>
  </main>
</BaseLayout>

<script>
  import "../scripts/obsidianMarkdown";

  function setupPostInteractions() {
    // 1. Reading Progress Bar
    const progressBar = document.getElementById("reading-progress");
    if (progressBar) {
      const updateProgress = () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
        progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
      };
      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();
    }

    // 2. Back to Top Button
    const backToTopBtn = document.getElementById("back-to-top");
    if (backToTopBtn) {
      backToTopBtn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    // 3. Share / Copy Post Link Button
    const copyLinkBtn = document.getElementById("copy-post-link");
    const copyLinkText = document.getElementById("copy-link-text");
    if (copyLinkBtn && copyLinkText) {
      copyLinkBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const originalText = copyLinkText.textContent;
          copyLinkText.textContent = "✓ 已复制链接！";
          copyLinkText.classList.add("text-success");
          setTimeout(() => {
            copyLinkText.textContent = originalText;
            copyLinkText.classList.remove("text-success");
          }, 2000);
        } catch {}
      });
    }
  }

  setupPostInteractions();
  document.addEventListener("astro:page-load", setupPostInteractions);
</script>
